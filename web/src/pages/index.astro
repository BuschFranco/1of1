---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Community from '../components/sections/Community.astro';
import Stats from '../components/sections/Stats.astro';
import DownloadCta from '../components/sections/DownloadCta.astro';

const lang = 'es' as const;
---

<Base
  lang={lang}
  title="1OF1 Basketball — Encontrá cancha. Jugá. Registrá cada partido."
  description="1of1 es la app de básquet para encontrar canchas cerca, registrar tus partidos automáticamente y seguir tu progreso: stats, rankings y logros."
>
  <Hero lang={lang} />
  <Features lang={lang} />
  <Community lang={lang}>
    <Stats lang={lang} />
  </Community>
  <DownloadCta lang={lang} />
</Base>
