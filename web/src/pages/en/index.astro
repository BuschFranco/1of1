---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import Features from '../../components/sections/Features.astro';
import Community from '../../components/sections/Community.astro';
import Stats from '../../components/sections/Stats.astro';
import DownloadCta from '../../components/sections/DownloadCta.astro';

const lang = 'en' as const;
---

<Base
  lang={lang}
  title="1OF1 Basketball — Find court. Play. Log every game."
  description="1of1 is the basketball app to find courts nearby, log your games automatically and track your progress: stats, rankings and achievements."
>
  <Hero lang={lang} />
  <Features lang={lang} />
  <Community lang={lang}>
    <Stats lang={lang} />
  </Community>
  <DownloadCta lang={lang} />
</Base>
