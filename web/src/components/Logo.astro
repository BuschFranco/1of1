---
import { asset } from '../lib/urls';

interface Props {
  /** Tamaño de referencia para los atributos width/height (evita saltos de
   * layout). El tamaño que se ve lo decide la CSS var `--logo-size`, para que
   * cada contexto pueda achicarlo por breakpoint. */
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<img
  class:list={['logo-mark', className]}
  src={asset('logo_1of1.png')}
  alt="1of1"
  width={size}
  height={size}
  decoding="async"
/>
