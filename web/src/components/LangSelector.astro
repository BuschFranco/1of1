---
interface Props {
  current: 'es' | 'en';
}
const { current = 'es' } = Astro.props;
---

<div class="lang-selector" data-base={import.meta.env.BASE_URL}>
  <button class={`lang-btn ${current === 'es' ? 'active' : ''}`} data-lang="es">ES</button>
  <span class="lang-divider">/</span>
  <button class={`lang-btn ${current === 'en' ? 'active' : ''}`} data-lang="en">EN</button>
</div>

<script is:inline>
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang;
      const base = btn.closest('.lang-selector').dataset.base || '/';
      const baseNorm = base.endsWith('/') ? base.slice(0, -1) : base;
      const path = window.location.pathname;
      const rel = path.startsWith(baseNorm) ? path.slice(baseNorm.length) : path;
      const isEn = rel.startsWith('/en');

      if (lang === 'en' && !isEn) {
        window.location.href = baseNorm + '/en' + rel;
      } else if (lang === 'es' && isEn) {
        window.location.href = baseNorm + rel.replace('/en', '') || baseNorm + '/';
      }
    });
  });
</script>

<style>
  .lang-selector {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 16px;
  }
  .lang-btn {
    background: none;
    border: none;
    color: var(--ink-muted);
    font-family: var(--font-label);
    font-weight: 800;
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    padding: 4px 6px;
    transition: color 0.2s;
  }
  @media (hover: hover) {
    .lang-btn:hover {
      color: var(--ink-variant);
    }
  }
  .lang-btn.active {
    color: var(--accent);
  }
  .lang-divider {
    color: var(--border);
    font-size: var(--fs-micro);
  }

  @media (max-width: 720px) {
    .lang-selector {
      margin-left: 8px;
    }
    /* Objetivo táctil de 44px sin agrandar el texto. */
    .lang-btn {
      min-width: 34px;
      min-height: 44px;
    }
  }
</style>
