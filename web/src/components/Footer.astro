---
import Logo from './Logo.astro';
import { useTranslations } from '../i18n';
import { url, type Lang } from '../lib/urls';

interface Props {
  lang: Lang;
  variant?: 'landing' | 'legal';
}
const { lang, variant = 'landing' } = Astro.props;
const t = useTranslations(lang);

const links =
  variant === 'landing'
    ? [
        { href: '#features', label: t.footer.features },
        { href: '#stats', label: t.footer.stats },
        { href: '#descargar', label: t.footer.download },
        { href: url(lang, 'terminos'), label: t.footer.terms },
        { href: url(lang, 'privacidad'), label: t.footer.privacy },
        { href: url(lang, 'eliminar-cuenta'), label: t.footer.deleteAccount },
      ]
    : [
        { href: url(lang), label: t.nav.home },
        { href: url(lang, 'terminos'), label: t.footer.terms },
        { href: url(lang, 'privacidad'), label: t.footer.privacy },
        { href: url(lang, 'eliminar-cuenta'), label: t.footer.deleteAccount },
      ];
---

<footer class="footer">
  <div class="footer-inner container">
    <Logo size={32} class="footer-logo" />
    <nav class="footer-links" aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="footer-copy">© 2024 1OF1 BASKETBALL. ALL RIGHTS RESERVED.</div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 32px;
    background: var(--bg-lowest);
    border-top: 2px solid var(--border);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .footer-logo {
    --logo-size: 32px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
  }

  .footer-links a,
  .footer-copy {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--ink-footer);
  }

  .footer-copy {
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: center;
  }

  @media (max-width: 720px) {
    .footer-links {
      gap: 12px 24px;
    }

    /* Objetivo táctil sin romper el wrap de la fila. */
    .footer-links a {
      padding-block: 6px;
    }
  }
</style>
