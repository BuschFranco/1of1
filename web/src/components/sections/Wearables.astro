---
import { useTranslations } from '../../i18n';
import type { Lang } from '../../lib/urls';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const w = t.wearables;
---

<section id="fisico" class="wearables section">
  <div class="container">
    <div class="section-head">
      <h2 class="h2">{w.title}</h2>
      <span class="eyebrow">{w.eyebrow}</span>
    </div>

    <p class="lead wearables-lead reveal">{w.lead}</p>

    <div class="wearables-grid">
      <div class="wearables-combo reveal reveal-left">
        <h3 class="h3 combo-title">{w.comboTitle}</h3>
        <p class="body combo-body">{w.comboBody}</p>
      </div>

      <!-- Dos curvas en ascenso: el físico (lo que mide el reloj) y el juego (los
           puntos que carga el usuario). Refuerza que las dos mitades suben juntas.
           Las líneas se dibujan solas cuando la sección entra en pantalla. -->
      <figure class="card chart reveal reveal-right">
        <figcaption class="chart-head">
          <span class="chart-title">{w.chartTitle}</span>
          <span class="chart-legend">
            <span class="chart-key chart-key--body">{w.chartPhysical}</span>
            <span class="chart-key chart-key--game">{w.chartGame}</span>
          </span>
        </figcaption>

        <svg class="chart-svg" viewBox="0 0 400 210" role="img" aria-label={`${w.chartTitle}: ${w.chartPhysical} / ${w.chartGame}`}>
          <defs>
            <linearGradient id="fillBody" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
            </linearGradient>
            <linearGradient id="fillGame" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--ok)" stop-opacity="0.2"></stop>
              <stop offset="100%" stop-color="var(--ok)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>

          <!-- Grilla de referencia -->
          <g class="chart-grid">
            <line x1="0" y1="45" x2="400" y2="45"></line>
            <line x1="0" y1="90" x2="400" y2="90"></line>
            <line x1="0" y1="135" x2="400" y2="135"></line>
            <line x1="0" y1="180" x2="400" y2="180"></line>
          </g>

          <!-- Áreas -->
          <polygon
            class="chart-area"
            fill="url(#fillGame)"
            points="20,185 20,178 67,170 114,156 161,160 208,138 255,126 302,116 349,96 380,76 380,185"
          ></polygon>
          <polygon
            class="chart-area"
            fill="url(#fillBody)"
            points="20,185 20,166 67,148 114,153 161,128 208,116 255,120 302,93 349,70 380,52 380,185"
          ></polygon>

          <!-- Líneas -->
          <polyline
            class="chart-line chart-line--game"
            points="20,178 67,170 114,156 161,160 208,138 255,126 302,116 349,96 380,76"
          ></polyline>
          <polyline
            class="chart-line chart-line--body"
            points="20,166 67,148 114,153 161,128 208,116 255,120 302,93 349,70 380,52"
          ></polyline>

          <!-- Último punto de cada serie: el "estás acá" -->
          <circle class="chart-dot chart-dot--game" cx="380" cy="76" r="4"></circle>
          <circle class="chart-dot chart-dot--body" cx="380" cy="52" r="4.5"></circle>
        </svg>

        <span class="chart-foot">{w.chartFoot}</span>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Alterna con el --bg-lowest de Seasons (la sección anterior). */
  .wearables {
    background: var(--bg);
  }

  .wearables-lead {
    max-width: 68ch;
  }

  .wearables-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
    margin-top: 32px;
  }

  .wearables-combo {
    padding-left: 20px;
    border-left: 4px solid var(--accent);
  }

  .combo-body {
    margin-top: 12px;
  }

  /* ── Gráfico de evolución ── */
  .chart {
    min-width: 0;
    padding: 24px;
  }

  .chart-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .chart-title {
    font-family: var(--font-label);
    font-weight: 800;
    font-style: italic;
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .chart-legend {
    display: flex;
    gap: 14px;
  }

  .chart-key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-micro);
    color: var(--ink-variant);
  }

  .chart-key::before {
    content: '';
    width: 10px;
    height: 3px;
    border-radius: 2px;
  }

  .chart-key--body::before {
    background: var(--accent);
  }

  .chart-key--game::before {
    background: var(--ok);
  }

  .chart-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart-grid line {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.35;
  }

  .chart-line {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chart-line--body {
    stroke: var(--accent);
  }

  .chart-line--game {
    stroke: var(--ok);
    stroke-width: 2.5;
  }

  .chart-dot--body {
    fill: var(--accent);
  }

  .chart-dot--game {
    fill: var(--ok);
  }

  .chart-foot {
    display: block;
    margin-top: 12px;
    font-family: var(--font-body);
    font-size: var(--fs-nano);
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }

  /* Las líneas se dibujan cuando la sección entra en pantalla (la clase .in la
     agrega el observer de Base.astro). Las áreas y los puntos aparecen después,
     así el ascenso se lee como progreso. */
  .chart-line,
  .chart-area,
  .chart-dot {
    transition:
      stroke-dashoffset 1.4s ease-out,
      opacity 0.6s ease-out;
  }

  .chart-line {
    stroke-dasharray: 620;
    stroke-dashoffset: 620;
  }

  .chart-area,
  .chart-dot {
    opacity: 0;
  }

  .reveal.in .chart-line {
    stroke-dashoffset: 0;
  }

  .reveal.in .chart-area,
  .reveal.in .chart-dot {
    opacity: 1;
    transition-delay: 0.9s;
  }

  .chart-line--game {
    transition-delay: 0.15s;
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-line {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
    .chart-area,
    .chart-dot {
      opacity: 1;
    }
  }

  @media (max-width: 1024px) {
    .wearables-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
