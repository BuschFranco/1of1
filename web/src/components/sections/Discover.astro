---
import { useTranslations } from '../../i18n';
import type { Lang } from '../../lib/urls';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const d = t.discover;
const sig = d.signature;
---

<section id="descubri" class="discover section">
  <div class="container">
    <div class="section-head">
      <h2 class="h2">{d.title}</h2>
      <span class="eyebrow">{d.eyebrow}</span>
    </div>

    <div class="discover-grid">
      <div class="discover-copy reveal reveal-left">
        <p class="lead">{d.lead}</p>
        <p class="body discover-body">{d.body}</p>
        <p class="discover-note">{d.note}</p>
      </div>

      <!-- Réplica de la card de cancha de la app: el visitante ve exactamente
           cómo va a quedar su firma una vez aprobada la cancha. -->
      <div class="discover-mock reveal reveal-right">
        <div class="card discover-card">
          <h3 class="h3 discover-court">{sig.court}</h3>
          <p class="discover-meta">{sig.meta}</p>
          <div class="discover-sign">
            <span class="material-symbols-outlined discover-pin">add_location_alt</span>
            <span class="discover-sign-label">{sig.label}</span>
            <span class="discover-clan">{sig.clan}</span>
            <span class="discover-handle">{sig.handle}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Alterna con el --bg-lowest de Features y con la foto de Community. */
  .discover {
    background: var(--bg);
  }

  .discover-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
  }

  .discover-body {
    margin-top: 16px;
  }

  .discover-note {
    margin-top: 24px;
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 46ch;
  }

  /* ── Mock de la firma ── */
  .discover-card {
    min-width: 0;
  }

  .discover-meta {
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    color: var(--ink-muted);
  }

  .discover-sign {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .discover-pin {
    color: var(--accent);
    font-size: 18px;
    margin-right: 2px;
  }

  .discover-sign-label {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    color: var(--ink-muted);
  }

  /* En la app el clan va entre corchetes y en color de acento; el handle ya
     trae el @ incorporado. */
  .discover-clan {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-micro);
    color: var(--accent);
  }

  .discover-handle {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-micro);
    color: var(--ink-strong);
  }

  @media (max-width: 1024px) {
    .discover-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
