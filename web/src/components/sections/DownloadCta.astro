---
import { useTranslations } from '../../i18n';
import type { Lang } from '../../lib/urls';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="descargar" class="cta">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="cta-inner container">
    <h2 class="cta-title">{t.cta.title}</h2>
    <p class="cta-sub">{t.cta.subtitle}</p>
    <p class="cta-free">{t.cta.freeNote}</p>
    <div class="cta-stores">
      <!-- Todavía no hay app publicada: los botones son placeholders (span, no
           link) y la etiqueta lo aclara. Al publicar, pasar a <a href> y quitar
           la etiqueta + el aria-disabled. -->
      <div class="store-slot">
        <span class="store-soon">{t.cta.comingSoon}</span>
        <span class="btn btn--store" aria-disabled="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
            ></path></svg
          >
          <span>{t.cta.appStore}</span>
        </span>
      </div>
      <div class="store-slot">
        <span class="store-soon">{t.cta.comingSoon}</span>
        <span class="btn btn--store" aria-disabled="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"
            ></path></svg
          >
          <span>{t.cta.playStore}</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y-lg);
    background: var(--accent);
    position: relative;
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 1), transparent);
  }

  .cta-inner {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-style: italic;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 16px;
  }

  .cta-sub {
    font-family: var(--font-body);
    font-size: var(--fs-lead);
    color: rgba(89, 30, 0, 0.8);
    max-width: 600px;
    margin: 0 auto 12px;
    font-weight: 700;
  }

  .cta-free {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    color: rgba(89, 30, 0, 0.6);
    max-width: 400px;
    margin: 0 auto 32px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .cta-stores {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .store-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .store-soon {
    font-family: var(--font-label);
    font-weight: 800;
    font-style: italic;
    font-size: var(--fs-nano);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(89, 30, 0, 0.75);
  }

  /* En móvil el botón de tienda va full width (base.css): el slot tiene que
     acompañar para que la etiqueta quede centrada sobre el botón. */
  @media (max-width: 720px) {
    .store-slot {
      width: 100%;
    }
  }
</style>
